{
  "manifest_version": 3,
  "name": "Đổi Code Delta Force (tự viết)",
  "short_name": "Đổi Code DF",
  "version": "1.0.0",
  "description": "Tự động nhập và đổi hàng loạt code Delta Force trên trang đổi quà Garena. Chạy cục bộ, không gửi dữ liệu ra ngoài.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://redeem.df.garena.sg/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Đổi Code Delta Force",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://redeem.df.garena.sg/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://redeem.df.garena.sg/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
